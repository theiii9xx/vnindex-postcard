# Copy this file to .env and fill in your own key (never commit .env — it's gitignored).
#
# Get a key at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# Optional: pick a specific ElevenLabs voice ID (defaults to a general
# multilingual voice if unset). Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
